# Copy to .env and fill in real values. deploy/install.sh generates this file for you;
# edit by hand only for local development or manual re-configuration.

# --- Panel HTTP ---
PANEL_PORT=9000
# Secret URL path segment the panel is served under (Caddy proxies /<TOKEN>/* to
# 127.0.0.1:$PANEL_PORT; everything else keeps going to the tproxy relay). Generate
# with: tr -dc 'a-zA-Z0-9' </dev/urandom | head -c20
PANEL_PATH_TOKEN=changeme20charrandomtoken

# --- Admin auth ---
ADMIN_LOGIN=admin
# bcrypt hash of the admin password, NOT the plaintext password.
# Generate with: tgproxy-panel -hash-password
ADMIN_PASSWORD_HASH=changeme
# Random 32+ byte secret used to sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=changeme

# --- Telegram bot ---
BOT_TOKEN=changeme
# Numeric Telegram user ID of the admin who receives pending-request notifications.
ADMIN_TELEGRAM_ID=changeme
# If true, proxies are issued automatically on request; if false, requests wait for
# admin approval in the panel or via the bot's inline buttons. Seeds the `settings`
# table on first run only — after that, edit it from the panel.
AUTO_ISSUE=false

# --- tproxy-server integration ---
TPROXY_HOSTNAME=proxy.example.com
TPROXY_SERVICE_NAME=tproxy-server
TPROXY_PROFILES_PATH=/etc/tproxy-server/profiles.json
TPROXY_CONFIG_PATH=/etc/tproxy-server/config.json
# tproxy-server's own admin API (config.json: admin_listen), used to confirm the
# service came back up healthy after a restart.
TPROXY_ADMIN_URL=http://127.0.0.1:8081
CADDYFILE_PATH=/etc/caddy/Caddyfile
# The single shared MTProxy backend every issued profile points at (see
# PLAN.md section 1 — one backend, shared by every profile, no per-user
# MTProxy process). Matches profiles.example.json's default unless your
# install used a different loopback port.
TPROXY_BACKEND=127.0.0.1:2398
TPROXY_CARRIER_MODE=https

# --- Storage ---
DB_PATH=/opt/tgproxy-panel/data/panel.db
BACKUP_DIR=/opt/tgproxy-panel/backup
BACKUP_KEEP=100

# --- Privileged apply step (see internal/applier and deploy/apply-profiles.sh) ---
APPLY_PROFILES_SCRIPT=/opt/tgproxy-panel/bin/apply-profiles.sh

# --- Logging (see internal/logging) ---
# "json" (production; the default, one JSON object per line for
# systemd/journald) or "text" (human-readable with source locations, for
# local development).
LOG_FORMAT=json
